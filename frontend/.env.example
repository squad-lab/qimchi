# Example environment variables for the frontend
# This file shows the keys read by `frontend/src/config.ts` in this repo.
# NOTE: `frontend/src/config.ts` expects VITE_-prefixed variables so Vite will
# expose them to client code. Use the VITE_ keys below or copy to `.env` and
# edit values for your environment.

# Use host + port (default: localhost:8000)
VITE_PROD_BACKEND_HOST=localhost
VITE_PROD_BACKEND_PORT=8000

# Optional: full HTTP/WS URL overrides (uncomment to use)
#VITE_PROD_BACKEND_URL=http://localhost:8000
#VITE_PROD_BACKEND_WS=ws://localhost:8000

# To enable, copy this file to .env (in the same folder) and edit values:
# PowerShell (pwsh):
# Copy-Item .env.example .env
# Unix / generic:
# cp .env.example .env

# After copying, run your Vite build/dev server and the VITE_* variables will
# be available as import.meta.env.VITE_PROD_BACKEND_... in client code.
